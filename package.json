{
  "name": "pattern-mirror",
  "version": "1.0.0",
  "description": "AI-powered emotional pattern analysis service. Backend/infra root (Firebase Functions, shared tooling).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "ts-node --project tsconfig.json backend/functions/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase": "^10.12.2",
    "firebase-admin": "^12.1.1",
    "firebase-functions": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  }
}
